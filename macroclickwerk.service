[Unit]
Description=Macroclickwerk input service (macro recording and playback)
Wants=graphical.target

[Install]
WantedBy=graphical.target

[Service]
# -a captures every keyboard and pointer, present now or plugged in later, so
# this unit works on any machine without editing. Devices another process holds
# exclusively — a key remapper's real keyboard — are left to it and its virtual
# output is captured instead, which keeps recorded keystrokes matching the
# letters actually pressed.
#
# To capture only specific devices, replace -a with -n lines. Names rather than
# paths, because anything paired through a wireless receiver gets no stable
# entry under /dev/input/by-id, and bare event numbers move around between
# boots. List yours with:
#   grep '^N: Name' /proc/bus/input/devices
# A name that matches nothing is only a warning, and the device is picked up on
# its own once it appears — this unit needs no ordering against whatever
# creates the devices it names. For example, behind a dvorak remapper (which
# must be told to leave macroclickwerk's clones alone:
#   ExecStart=/usr/local/bin/dvorak -d /dev/input/%i -i "macroclickwerk virtual"):
#   ExecStart=/usr/local/bin/macroclickwerk \
#     -n "Virtual Dvorak Keyboard" \
#     -n "Logitech Signature M650 L"
ExecStart=/usr/local/bin/macroclickwerk -a
Restart=on-failure
RestartSec=2
StandardOutput=null
StandardError=journal
